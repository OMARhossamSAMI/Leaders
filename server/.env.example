# Copy to .env and fill in. Never commit real values.
# On Render these are set in the service's Environment page.

# Database (required). Use a local database for development, e.g.
# mongodb://127.0.0.1:27017/leaders_website_dev
MONGO_URI=

# Admin login
JWT_SECRET=
JWT_EXPIRES_IN=12h
HR_EMAIL=
HR_PASSWORD=
IT_EMAIL=
IT_PASSWORD=
ADMISSION_EMAIL=
ADMISSION_PASSWORD=

# Email
SENDGRID_API_KEY=
GMAIL_USER=
GMAIL_PASS=

# Server
Backend_URL=
PORT=3000

# Paymob
PAYMOB_BASE=
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=

# WhatsApp (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WA_TOKEN=
WA_VERIFY_TOKEN=
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=
WA_TEMPLATE_PARAM_COUNT=
WA_CUSTOM_TEMPLATE_NAME=
WA_CUSTOM_TEMPLATE_LANG=
WA_CUSTOM_TEMPLATE_HAS_HEADER=
WA_SURVEY_BTN_ENABLED=
SURVEY_URL=
